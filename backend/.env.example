# ---------------------------------------------------------------------------
# Backend environment — template only. Contains NO real values.
#
#   Local:      copy to backend/.env (git-ignored). `npm run dev` / `npm start`
#               load it automatically through Node's --env-file-if-exists flag.
#   Hosting:    set these in the platform's environment-variable settings.
#               Never upload a .env file and never commit real values.
# ---------------------------------------------------------------------------

# REQUIRED IN PRODUCTION. Secret used to sign login tokens.
# With NODE_ENV=production the server refuses to start without it.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Optional. The FIRST administrator password, used only when the admin
# account is created on a brand-new database. Leave it empty and a strong
# one is generated and printed to the server log once, which the account
# must then change at first sign-in. No password is stored in the source.
SEED_ADMIN_PASSWORD=

# --------------------------- Supabase (persistence) ------------------------
# REQUIRED IN PRODUCTION. With both set, the backend stores its data in
# Supabase PostgreSQL and its uploads in Supabase Storage. With neither set it
# uses the local JSON file and local folders (development only — that data
# does not survive a redeploy).
SUPABASE_URL=

# SERVICE-ROLE KEY — BACKEND ONLY.
# It bypasses Row Level Security, so it must never appear in the frontend, in
# a VITE_ variable, in an API response, in the README or in git.
# Copy it from: Supabase dashboard -> Project Settings -> API -> service_role.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Storage bucket names (defaults shown in comments).
# SUPABASE_PUBLIC_BUCKET=cms-public
# SUPABASE_PRIVATE_BUCKET=cms-private

# Optional. How long the edge may serve a stored copy of a PUBLIC page
# response, in seconds (default 60). This is also how long an administrator
# waits before a change shows on the public site. Set to 0 to disable edge
# caching. Signed-in responses are never cached, whatever this is set to.
PUBLIC_CACHE_SECONDS=

# ------------------------------- server ------------------------------------
# Optional. Port to listen on (default 5000). Most hosts set PORT themselves.
PORT=

# Optional. Directory holding data.json, uploads/ and private-uploads/ when
# Supabase is NOT configured. Defaults to the backend folder.
DATA_DIR=

# Optional. Comma-separated origins allowed to call the API cross-origin,
# e.g. https://www.example.com. Leave empty when the frontend is served from
# the same domain (the normal setup) — no CORS headers are sent then.
CORS_ORIGINS=

# Set by most hosting platforms automatically. When "production", JWT_SECRET
# and the Supabase variables are mandatory.
NODE_ENV=
