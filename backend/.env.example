# ---------------------------------------------------------------------------
# Backend environment — template only. Contains NO real values.
#
#   1. Copy this file to backend/.env
#   2. Fill in real values
#   3. Never commit backend/.env (it is git-ignored)
#
# `npm run dev` and `npm start` load backend/.env automatically through Node's
# --env-file-if-exists flag. On a hosting platform, set these in its
# environment-variable settings instead of uploading a .env file.
# ---------------------------------------------------------------------------

# Port the API listens on. Optional — defaults to 5000.
# Most hosting platforms set PORT for you; leave it unset there.
PORT=5000

# Secret used to sign login tokens. REQUIRED IN PRODUCTION.
# If left empty, the server falls back to a built-in development secret that
# is visible in the source code. Generate a long random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
